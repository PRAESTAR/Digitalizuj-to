# =============================================================================
# digitalizuj.to — Apache konfigurácia pre statický export (output: 'export')
#
# Tento súbor preberá VŠETKO, čo v serverovom režime robil Next.js:
#   1. bezpečnostné hlavičky   (zrkadlo securityHeaders z next.config.ts)
#   2. legacy 301 presmerovania (zrkadlo redirects() z next.config.ts)
#   3. jazykovú negociáciu /    (zrkadlo proxy.ts — next-intl middleware)
#   4. mapovanie čistých URL na .html súbory exportu
#
# Pri zmene hlavičiek/redirectov v next.config.ts treba upraviť AJ tento
# súbor — sú to dve kópie tej istej pravdy pre dva runtime režimy.
# =============================================================================

AddDefaultCharset UTF-8
Options -Indexes

# Export vytvára pre stránky AJ adresáre (sk/, sk/peers/ — nesú klientské
# navigačné payloady __next.*), takže mod_dir na čistej URL /sk pridával
# lomítko a naše pravidlo nižšie ho zase odoberalo — slučka presmerovaní.
# DirectorySlash Off mod_dir umlčí; čisté URL obslúži interný rewrite na
# .html a adresárový listing blokuje -Indexes vyššie.
DirectorySlash Off

# --- MIME typy, ktoré staršie Apache inštalácie nemusia poznať --------------
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

# Pomocné súbory publish kroku nemajú byť stiahnuteľné cez HTTP — publish.php
# ich číta z disku, webu do nich nič nie je (odhaľovali by mená tabuliek).
<FilesMatch "\.(sql|bak|log)$">
  Require all denied
</FilesMatch>

# Route handlery exportu sú súbory bez prípony — bez ForceType by ich Apache
# poslal ako text/plain a OG scrapery by obrázok zahodili.
<Files "opengraph-image">
  ForceType image/png
</Files>
# Pravidlo pre "icon" tu zámerne nie je — favicon aj generovaná ikona boli
# odstránené (5. 8. 2026). Pri návrate ikony ho treba doplniť späť, inak ju
# Apache pošle ako text/plain.

# --- 1. Bezpečnostné hlavičky ------------------------------------------------
<IfModule mod_headers.c>
  # GA4 (gtag.js) sa pripája až po súhlase, ale CSP ho musí povoliť tak či tak.
  # Wildcard v connect-src je nutnosť: GA4 posiela zásahy na regionálne
  # endpointy (region1.google-analytics.com), samotné www.google-analytics.com
  # by v EÚ meranie zabilo. Reklamné domény (doubleclick, googlesyndication)
  # tu zámerne nie sú — treba ich až pri Google Ads / Signals.
  # CookieYes (cookie banner) beží na DVOCH rôznych doménach: skript na
  # cdn-cookieyes.com (spojovník, nie poddoména!) a zvyšok služby na
  # log./app./www.cookieyes.com — wildcard *.cookieyes.com tú prvú NEPOKRÝVA.
  # 'unsafe-eval' netreba: jediné `new Function` v ich skripte je webpackova
  # detekcia globálu obalená try/catch s fallbackom na window (overené v kóde).
  # Cloudflare Turnstile potrebuje script-src AJ frame-src — widget beží
  # v cross-origin iframe a bez frame-src by padol na default-src 'self'
  # a ticho sa zablokoval (chyba 200500 "iframe load error").
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://cdn-cookieyes.com https://*.cookieyes.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn-cookieyes.com https://*.cookieyes.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://cdn-cookieyes.com https://*.cookieyes.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cdn-cookieyes.com https://*.cookieyes.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; media-src 'self'; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
  Header always set X-XSS-Protection "1; mode=block"

  # Hashované assety sú nemenné — agresívna cache je bezpečná a je to
  # najlacnejšie zrýchlenie opakovaných návštev.
  SetEnvIf Request_URI "^/_next/static/" NEXT_IMMUTABLE
  Header set Cache-Control "public, max-age=31536000, immutable" env=NEXT_IMMUTABLE

  # Kompilovaný model: current.json sa mení publishom — nikdy necachovať
  # dlho; verziované v{N}.json sú nemenné.
  SetEnvIf Request_URI "^/model/current\.json$" MODEL_CURRENT
  Header set Cache-Control "no-cache" env=MODEL_CURRENT
  SetEnvIf Request_URI "^/model/v[0-9]+\.json$" MODEL_VERSIONED
  Header set Cache-Control "public, max-age=31536000, immutable" env=MODEL_VERSIONED

  # Vary na jazykovej negociácii koreňa (nastavuje sa env flagom nižšie).
  # `always` je povinné: bez neho sa Header direktíva na 3xx odpovede
  # (redirect z mod_rewrite) vôbec neaplikuje — overené na živom serveri.
  # Cookie tiež: cieľ presmerovania závisí aj od NEXT_LOCALE cookie.
  Header always append Vary "Accept-Language" env=LANG_NEGOTIATED
  Header always append Vary "Cookie" env=LANG_NEGOTIATED
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- 3. Jazyková negociácia koreňa ----------------------------------------
  # Poradie signálov: ULOŽENÁ VOĽBA (cookie NEXT_LOCALE — nastavuje vlajkový
  # prepínač aj geo banner) má prednosť pred jazykom prehliadača. Kto si raz
  # jazyk vybral, koreň ho tam pošle bez ohľadu na Accept-Language.
  RewriteCond %{HTTP_COOKIE} (^|;\s*)NEXT_LOCALE=(sk|cs|en) [NC]
  RewriteRule ^$ /%2 [R=302,E=LANG_NEGOTIATED:1,L]
  # / → /cs|/en podľa Accept-Language, inak /sk. Nemecké prehliadače idú na
  # EÚ (anglickú) mutáciu — nemčina bola vyradená (tri trhy: SK/CZ/EÚ).
  # 302 (nie 301): cieľ závisí od hlavičky požiadavky, trvalé presmerovanie
  # by si prehliadače a CDN cachli bez ohľadu na jazyk.
  RewriteCond %{HTTP:Accept-Language} ^cs [NC]
  RewriteRule ^$ /cs [R=302,E=LANG_NEGOTIATED:1,L]
  RewriteCond %{HTTP:Accept-Language} ^(en|de) [NC]
  RewriteRule ^$ /en [R=302,E=LANG_NEGOTIATED:1,L]
  RewriteRule ^$ /sk [R=302,E=LANG_NEGOTIATED:1,L]

  # Nemecká mutácia zrušená (2. 8. 2026) — staré /de adresy natrvalo na
  # anglickú/EÚ verziu, nech zaindexované URL nekončia 404.
  RewriteRule ^de$ /en [R=301,L]
  RewriteRule ^de/(.*)$ /en/$1 [R=301,L]

  # --- 2. Legacy presmerovania (pred-i18n adresy) ---------------------------
  # Zrkadlo redirects() z next.config.ts — trvalé 301.
  RewriteRule ^peers/?$ /sk/peers [R=301,L]
  RewriteRule ^changelog/?$ /sk/changelog [R=301,L]
  RewriteRule ^quiz/?$ /sk/quiz [R=301,L]
  RewriteRule ^results/?$ /sk/results [R=301,L]
  RewriteRule ^r/([A-Za-z0-9]+)/?$ /sk/r/$1 [R=301,L]

  # --- 4. Čisté URL → .html súbory exportu ----------------------------------
  # Export generuje sk.html, sk/peers.html…; canonicaly a sitemap používajú
  # tvary bez prípony — tie sa NESMÚ zmeniť (SEO revízia). Preto mapujeme
  # interne, bez presmerovania.
  # a) /sk/peers/ → /sk/peers (adresár sk/ existuje kvôli podstránkam,
  #    inak by Apache servíroval adresár namiesto sk.html)
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^ /%1 [R=301,L]
  # b) /sk/peers → sk/peers.html (interne)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
  # c) /{jazyk}/r/<hash> bez exportovaného súboru → generická stránka výsledku.
  #    Export vie vyrobiť .html len pre vopred známe hashe (50 ukážkových
  #    profilov), takže vlastný výsledok návštevníka by inak skončil na 404 —
  #    a s ním aj celý permanentný odkaz a QR kód. Prepis je interný (žiadne
  #    presmerovanie), takže hash zostáva v adrese a stránka si ho z nej
  #    prečíta. Musí byť AŽ ZA pravidlom b): ukážkové profily majú vlastný
  #    súbor a to pravidlo ich chytí skôr.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html !-f
  RewriteRule ^(sk|cs|en)/r/[A-Za-z0-9]+/?$ /$1/r/view.html [L]
</IfModule>

ErrorDocument 404 /404.html
