{
  "name": "digitalizuj-to",
  "version": "1.1.0",
  "private": true,
  "description": "Digitálna auditná platforma pre malé a stredné podniky — meranie digitálnej zrelosti, rizikový profil a prioritizované odporúčania na báze EU Digital Intensity Index (DII) a Operational Digital Readiness Modelu.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/validate-model.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "validate:model": "node scripts/validate-model.mjs",
    "db:import": "node scripts/db/import.mjs",
    "db:compile": "node scripts/db/compile.mjs --check",
    "model:pull": "node scripts/db/pull.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "next": "^16.2.4",
    "next-intl": "^4.13.4",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.14",
    "sharp": "^0.35.0"
  }
}
